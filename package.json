{
  "name": "matchscores",
  "version": "1.0.0",
  "private": true,
  "description": "MatchScores — analyse des cotes Bet261 (sports & virtuels) et conseils de paris à faible risque",
  "scripts": {
    "dev": "npm run build:assistant && next dev",
    "build": "npm run build:assistant && next build",
    "start": "next start",
    "build:assistant": "node scripts/build-assistant.mjs",
    "scrape:local": "tsx scripts/scrape-local.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
